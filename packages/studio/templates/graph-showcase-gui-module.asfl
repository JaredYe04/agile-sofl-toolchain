module GUI_App / SmartCity;
const
    view_dash = 0;
    view_alerts = 1;
    view_citizens = 2;
type
    ViewId = nat;
var
    current_view: ViewId;
    alerts_open: nat;
inv
    current_view >= 0 and current_view <= 2 and alerts_open >= 0;
gui CityGui;
screen Dashboard;
    label title "Smart City";
    navigation goAlerts "Alerts" triggers OpenAlerts;
    navigation goCitizens "Citizens" triggers OpenCitizens;
end_screen;
screen Alerts;
    text-input sensorId "Sensor";
    button dispatch "Dispatch" triggers DoDispatch;
    navigation backDash "Dashboard" triggers OpenDashboard;
end_screen;
screen Citizens;
    text-input citizenId "Citizen";
    button register "Register" triggers DoRegister;
    navigation backDash2 "Dashboard" triggers OpenDashboard;
end_screen;
end_gui;
process OpenAlerts ()
    FSF :
    others && current_view = 1
end_process
process OpenCitizens ()
    FSF :
    others && current_view = 2
end_process
process OpenDashboard ()
    FSF :
    others && current_view = 0
end_process
process DoDispatch equal SmartCity.DispatchAlert end_process
process DoRegister equal SmartCity.RegisterCitizen end_process
end_module
