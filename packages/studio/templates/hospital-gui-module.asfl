module GUI_App / Hospital;
const
    view_home = 0;
    view_register = 1;
    view_triage = 2;
    view_assign = 3;
type
    ViewId = nat;
var
    current_view: ViewId;
    ticket_issued: nat;
inv
    current_view >= 0 and current_view <= 3 and ticket_issued >= 0;
gui ClinicGui;
  screen Home;
  screen Register triggers DoRegister;
  screen Triage triggers DoTriage;
  screen Assign triggers DoAssign;
end_gui;
process OpenRegister ()
    FSF :
    others && current_view = 1
end_process
process OpenTriage ()
    FSF :
    others && current_view = 2
end_process
process OpenAssign ()
    FSF :
    ticket_issued > 0 && current_view = 3 ||
    others && current_view = 1
end_process
process OpenHome ()
    FSF :
    others && current_view = 0
end_process
process DoRegister equal Hospital.Register end_process
process DoTriage equal Hospital.Triage end_process
process DoAssign equal Hospital.AssignDoctor end_process
end_module
