module GUI_App / Ecommerce;
const
    view_home = 0;
    view_cart = 1;
    view_checkout = 2;
    view_orders = 3;
type
    ViewId = nat;
var
    current_view: ViewId;
    cart_open: nat;
inv
    current_view >= 0 and current_view <= 3 and cart_open >= 0;
gui ShopGui;
  screen Home;
  screen Cart triggers DoAddToCart;
  screen Checkout triggers DoCheckout;
  screen Orders triggers DoRefund;
end_gui;
process OpenCart ()
    FSF :
    others && current_view = 1
end_process
process OpenCheckout ()
    FSF :
    cart_open > 0 && current_view = 2 ||
    others && current_view = 1
end_process
process OpenOrders ()
    FSF :
    others && current_view = 3
end_process
process OpenHome ()
    FSF :
    others && current_view = 0
end_process
process DoAddToCart equal Ecommerce.AddToCart end_process
process DoCheckout equal Ecommerce.Checkout end_process
process DoRefund equal Ecommerce.Refund end_process
end_module
