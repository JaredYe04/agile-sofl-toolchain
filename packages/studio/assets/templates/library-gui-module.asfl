module GUI_App / Library;
const
    view_home = 0;
    view_borrow = 1;
    view_return = 2;
type
    ViewId = nat;
var
    current_view: ViewId;
    session_ok: nat;
inv
    current_view >= 0 and current_view <= 2 and session_ok >= 0;
gui LibraryGui;
  screen Home;
  screen Borrow triggers DoBorrow;
  screen ReturnBook triggers DoReturn;
end_gui;
process OpenBorrow ()
    FSF :
    others && current_view = 1
end_process
process OpenReturn ()
    FSF :
    others && current_view = 2
end_process
process OpenHome ()
    FSF :
    others && current_view = 0
end_process
process DoBorrow equal Library.Borrow end_process
process DoReturn equal Library.Return end_process
end_module
