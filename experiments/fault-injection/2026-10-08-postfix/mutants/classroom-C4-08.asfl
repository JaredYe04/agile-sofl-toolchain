FSF:
  c <= 10 && has = true
     and st.max inset {x.score | x: scores & x.course_id = c}
     and (forall[x: scores] | x.course_id <> c or x.score <= st.max)
     and st.min inset {x.score | x: scores & x.course_id = c}
     and (forall[x: scores] | x.course_id <> c or x.score >= st.min)
     and st.avg = Sum([x.score | x: scores & x.course_id = c]) / card({x | x: scores & x.course_id = c})
     and (forall[k: {0,...,10}] | st.distribution(k) = card({x | x: scores & x.course_id = c and x.score div 10 = k}))
||
  c > 10 && has = false
end_process;
