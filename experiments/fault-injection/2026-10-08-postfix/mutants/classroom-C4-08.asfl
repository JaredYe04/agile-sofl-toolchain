process DeleteStudent(op: UserName, sid: StudentId) ok: bool                /* [F5] 删 */
ext rd teachers wr students
FSF:
  op inset dom(teachers) and teachers(op).role = <Admin> and sid inset dom(~students)
  && students = domrb({sid}, ~students) and ok = true
||
  others && students = ~students and ok = false
end_process;
