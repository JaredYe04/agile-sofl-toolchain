process QueryStudent(sid: StudentId) found: bool, s: Student                /* [F5] 查 */
ext rd students
FSF:
  sid inset dom(students) && found = true and s = students(sid)
||
  others && found = false
end_process;
process QueryStudent_d2(sid: StudentId) found: bool, s: Student                
ext rd students
FSF:
  sid <= 10 && found = true and s = students(sid)
||
  sid > 10 && found = false
end_process;
process QueryStudent_d3(sid: StudentId) found: bool, s: Student                
ext rd students
FSF:
  sid < 10 && undeclared_found = true and s = students(sid)
||
  sid >= 10 and sid <= 20 && found = false
||
  sid > 20 && found = false
end_process;
