end_process;
process TeacherTimetable(u: UserName) tt: set of TimetableEntry             /* [F2] 按教师 */
ext rd timetable rd courses
FSF:
  true && tt = {e | e: timetable & courses(e.course_id).teacher = u}
end_process
end_module;

module Records_Decom / MasterData_Decom;
var
  attendance: set of AttendanceRecord;        /* [D5] */
  scores: set of ScoreRecord;                 /* [D6] */
  assignments: map AssignmentId to Assignment /* [D7]; [C4] */
;
inv
  forall[r: scores] | min_score <= r.score <= max_score;  /* [C1] */
  forall[a: rng(assignments)] | a.deadline > a.assigned_at;  /* [C5] */
  forall[r: attendance] | r.course_id inset dom(courses) and r.student_id inset dom(students);  /* [C8] */
  forall[r: scores] | r.course_id inset dom(courses) and r.student_id inset dom(students);  /* [C8] */
  forall[a: rng(assignments)] | a.course_id inset dom(courses);  /* [C8] */
  forall[a: rng(assignments)] | subset(dom(a.submissions), dom(students)) and subset(dom(a.results), dom(a.submissions))  /* [C8][D7] */
;
process RecordAttendance(op: UserName, r: AttendanceRecord) ok: bool        /* [F1][D5] */
ext rd teachers rd courses rd students wr attendance
FSF:
  op inset dom(teachers)
  and Authorized(teachers, op, r.course_id) /* [C3] */
  and r.course_id inset dom(courses) and r.student_id inset dom(students)     /* [C8] */
  and not (exists[x: ~attendance] | x.course_id = r.course_id and x.date = r.date
           and x.student_id = r.student_id)
  && attendance = union(~attendance, {r}) and ok = true
||
  others && attendance = ~attendance and ok = false
end_process;
process QueryAttendance(kind: {<ByCourse>, <ByDate>, <ByStudent>}, c: CourseId, d: Date, sid: StudentId) rs: set of AttendanceRecord /* [F1] */
ext rd attendance
FSF:
  kind = <ByCourse> && rs = {x | x: attendance & x.course_id = c}
||
  kind = <ByDate> && rs = {x | x: attendance & x.date = d}
||
  kind = <ByStudent> && rs = {x | x: attendance & x.student_id = sid}
end_process;
process RecordScore(op: UserName, sid: StudentId, c: CourseId, sc: int, now: Time) ok: bool /* [F3][D6] */
ext rd teachers rd students rd courses wr scores
FSF:
  op inset dom(teachers)
  and Authorized(teachers, op, c)           /* [C3] */
  and sid inset dom(students) and c inset dom(courses)                        /* [C8] */
  and min_score <= sc <= max_score                                            /* [C1] */
  and not (exists[x: ~scores] | x.student_id = sid and x.course_id = c)
  && scores = union(~scores, {mk_ScoreRecord(sid, c, sc, now)}) and ok = true
||
  others && scores = ~scores and ok = false
end_process;
process RecordScore_d2(op: UserName, sid: StudentId, c: CourseId, sc: int, now: Time) ok: bool 
ext rd teachers rd students rd courses wr scores
FSF:
  sid <= 10 && scores = union(~scores, {mk_ScoreRecord(sid, c, sc, now)}) and ok = true
||
  sid > 10 && scores = ~scores and ok = false
end_process;
process RecordScore_d3(op: UserName, sid: StudentId, c: CourseId, sc: int, now: Time) ok: bool 
ext rd teachers rd students rd courses wr scores
FSF:
  sid < 10 && scores = union(~scores, {mk_ScoreRecord(sid, c, sc, now)}) and ok = true
||
  sid >= 10 and sid <= 20 && scores = ~scores and ok = false
||
  sid > 20 && scores = ~scores and ok = false
end_process;
process RecordScore_dg(op: UserName, sid: StudentId, c: CourseId, sc: int, now: Time) ok: bool 
ext rd teachers rd students rd courses wr scores
FSF:
  sid < 10 && scores = union(~scores, {mk_ScoreRecord(sid, c, sc, now)}) and ok = true
||
  sid > 10 && scores = ~scores and ok = false
||
  others && scores = ~scores and ok = false
end_process;
process RecordScore_dc(op: UserName, sid: StudentId, c: CourseId, sc: int, now: Time) ok: bool 
ext rd teachers rd students rd courses wr scores
FSF:
