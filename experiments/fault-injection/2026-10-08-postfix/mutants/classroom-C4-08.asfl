process AssignHomework(op: UserName, aid: AssignmentId, a: Assignment) ok: bool /* [F4][D7] */
ext rd teachers rd courses wr assignments
FSF:
  op inset dom(teachers)
  and Authorized(teachers, op, a.course_id) /* [C3] */
  and aid notin dom(~assignments)                                             /* [C4] */
  and a.course_id inset dom(courses)                                          /* [C8] */
  and a.deadline > a.assigned_at                                              /* [C5] */
  and a.submissions = {->} and a.results = {->}
  && assignments = override(~assignments, {aid -> a}) and ok = true
||
  others && assignments = ~assignments and ok = false
end_process;
process AssignHomework_d2(op: UserName, aid: AssignmentId, a: Assignment) ok: bool 
ext rd teachers rd courses wr assignments
FSF:
  aid <= 10 && assignments = override(~assignments, {aid -> a}) and ok = true
||
  aid > 10 && assignments = ~assignments and ok = false
end_process;
