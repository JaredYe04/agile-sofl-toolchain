process SubmitHomework(aid: AssignmentId, sub: Submission) ok: bool         /* [F4] */
ext rd students wr assignments
FSF:
  aid inset dom(~assignments) and sub.student_id inset dom(students)          /* [C8] */
  && assignments = override(~assignments, {aid -> modify(~assignments(aid),
       submissions -> override(~assignments(aid).submissions, {sub.student_id -> sub}))})
     and ok = true
||
  others && assignments = ~assignments and ok = false
end_process;
