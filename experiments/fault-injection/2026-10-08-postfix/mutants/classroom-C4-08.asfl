process AddClass(op: UserName, cid: ClassId, c: Class) ok: bool             /* [F5][D2] */
ext rd teachers wr classes
FSF:
  op inset dom(teachers) and teachers(op).role = <Admin>
  and cid notin dom(~classes) and c.head_teacher inset dom(teachers)          /* [C8] */
  && classes = override(~classes, {cid -> c}) and ok = true
||
  others && classes = ~classes and ok = false
end_process;
process AddClass_d2(op: UserName, cid: ClassId, c: Class) ok: bool             
ext rd teachers wr classes
FSF:
  cid <= 10 && classes = override(~classes, {cid -> c}) and ok = true
||
  cid > 10 && classes = ~classes and ok = false
end_process;
