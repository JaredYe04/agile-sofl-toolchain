process ViewSubmissions(aid: AssignmentId) found: bool, subs: map StudentId to Submission, res: map StudentId to GradingResult /* [F4] */
ext rd assignments
FSF:
  aid inset dom(assignments) && found = true and subs = assignments(aid).submissions and res = assignments(aid).results
||
  others && found = false
end_process;
