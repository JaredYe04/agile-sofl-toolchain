process GradeHomework(op: UserName, aid: AssignmentId, sid: StudentId, g: GradingResult) ok: bool /* [F4] */
ext rd teachers wr assignments
FSF:
  aid inset dom(~assignments) and sid inset dom(~assignments(aid).submissions)
  and op inset dom(teachers)
  and Authorized(teachers, op, ~assignments(aid).course_id) /* [C3] */
  && assignments = override(~assignments, {aid -> modify(~assignments(aid),
       results -> override(~assignments(aid).results, {sid -> g}))})
     and ok = true
||
  others && assignments = ~assignments and ok = false
end_process;
