end_process;
process AddCourse(op: UserName, cid: CourseId, c: Course, cls: ClassId) ok: bool /* [F2][D3][D4] */
ext rd teachers rd classes wr courses wr timetable
FSF:
  op inset dom(teachers) and teachers(op).role = <Admin>                      /* [C3] */
  and cid notin dom(~courses)                                                 /* [C4] */
  and c.teacher inset dom(teachers) and cls inset dom(classes)                /* [C8] */
  and 1 <= c.slot.period <= max_period
  and not (exists[e: ~timetable] | e.slot = c.slot and e.class_id = cls
           or e.slot = c.slot and ~courses(e.course_id).teacher = c.teacher)  /* [C7] */
  && courses = override(~courses, {cid -> c})
     and timetable = union(~timetable, {mk_TimetableEntry(cls, c.slot, cid)}) and ok = true
||
  others && courses = ~courses and timetable = ~timetable and ok = false
end_process;
process AddCourse_d2(op: UserName, cid: CourseId, c: Course, cls: ClassId) ok: bool 
ext rd teachers rd classes wr courses wr timetable
FSF:
  cid <= 10 && courses = override(~courses, {cid -> c})
     and timetable = union(~timetable, {mk_TimetableEntry(cls, c.slot, cid)}) and ok = true
||
  cid > 10 && courses = ~courses and timetable = ~timetable and ok = false
end_process;
