/* Reference hybrid specification: 课堂管理系统 (Classroom Management), data-oriented.
   Version v0.2 (draft, NOT frozen; module-write restructure 2026-10-07). Author: Agile-SOFL domain advisor.
   Traceability: every element carries [Fn]/[Dn]/[Cn] = informal item id (see experiment-systems.md).
   Predicates that realise a listed constraint are tagged [Cn] in the comment on the same line. */
module SYSTEM_Classroom;
const
  min_score = 0;                                   /* [C1] */
  max_score = 100;                                 /* [C1] */
  min_pwd_len = 6;                                 /* [C6] */
  max_period = 8                                   /* [D4] 第1-8节 */
;
type
  StudentId = nat;  ClassId = nat;  CourseId = nat;  AssignmentId = nat;
  UserName = string;  Time = nat0;  Date = nat0;
  Gender = {<Male>, <Female>};                                   /* [D1] 男/女 */
  Grade = {<G10>, <G11>, <G12>};                                 /* [D2] 高一/高二/高三 */
  Weekday = {<Mon>, <Tue>, <Wed>, <Thu>, <Fri>};                 /* [D4] */
  AttendanceStatus = {<Normal>, <Late>, <LeftEarly>, <Absent>};  /* [D5][C2] 正常/迟到/早退/缺勤 */
  Role = {<Admin>, <Teacher>};                                   /* [D8] 管理员/普通教师 */
  Slot = composed of day: Weekday period: nat end;               /* [D4] 星期+节次 */
  Student = composed of name: string gender: Gender contact: string
            class_id: ClassId enroll_year: nat end;              /* [D1] */
  Class = composed of name: string head_teacher: UserName grade: Grade end;   /* [D2] */
  Course = composed of name: string teacher: UserName slot: Slot place: string end; /* [D3] */
  TimetableEntry = composed of class_id: ClassId slot: Slot course_id: CourseId end; /* [D4] */
  AttendanceRecord = composed of course_id: CourseId date: Date
            student_id: StudentId status: AttendanceStatus end;  /* [D5] */
  ScoreRecord = composed of student_id: StudentId course_id: CourseId
            score: nat0 recorded_at: Time end;                   /* [D6] */
  Submission = composed of student_id: StudentId submit_time: Time attachment: string end; /* [D7] */
  GradingResult = composed of mark: nat0 remark: string end;     /* [D7] 评分、评语 */
  Assignment = composed of title: string requirement: string assigned_at: Time
            deadline: Time course_id: CourseId
            submissions: map StudentId to Submission
            results: map StudentId to GradingResult end;         /* [D7] */
  Teacher = composed of password: string name: string role: Role
            courses: set of CourseId end;                        /* [D8] */
  Stats = composed of avg: real max: nat0 min: nat0
            distribution: map nat0 to nat0 end                   /* [F3] 分布: 分数段(0..10)->人数 */
;
/* ---------- non-bottom level: semi-formal FSF ---------- */
process Attendance(op: UserName, req: string) reply: string                  /* [F1] 学生考勤管理 */
FSF:
  the request records an attendance status of a student for a course and date,
  and op is an admin or teaches that course &&
  the record is stored and reply reports success
||
  the request queries attendance by course, by date or by student &&
  reply lists the matching attendance records
||
  others && attendance is unchanged and reply reports the error
decom: Records_Decom
end_process;
process CourseTimetable(op: UserName, req: string) reply: string             /* [F2] 课程与课表管理 */
FSF:
  the request maintains course information and op is an admin &&
  the course or timetable store is updated and reply reports success
||
  the request asks for the weekly timetable of a class or of a teacher &&
  reply shows the timetable entries of that class or teacher
||
  others && the course store and the timetable store are unchanged and reply reports the error
decom: MasterData_Decom
end_process;
process ScoreManagement(op: UserName, req: string) reply: string             /* [F3] 成绩录入与统计 */
FSF:
  the request enters a 0-100 score of a student for a course taught by op &&
  the score record is stored and reply reports success
||
  the request asks for statistics of a course &&
  reply gives average, highest, lowest score and distribution of the course
||
  others && scores is unchanged and reply reports the error
decom: Records_Decom
end_process;
process Homework(op: UserName, req: string) reply: string                    /* [F4] 作业布置与提交 */
FSF:
  the request is a teacher assigning homework with a deadline later than now &&
  the assignment is stored and reply reports success
||
  the request is a student submitting homework of an existing assignment &&
  the submission is stored and reply reports success
||
  the request is a teacher grading a submitted homework &&
  the grading result is stored and reply reports success
||
  the request is a teacher viewing submissions of an assignment &&
  reply lists the submissions and results
||
  others && assignments is unchanged and reply reports the error
decom: Records_Decom
end_process;
process StudentClassInfo(op: UserName, req: string) reply: string            /* [F5] 学生与班级信息管理 */
FSF:
  the request adds, modifies, deletes or queries a student or a class
  and op is an admin &&
  the corresponding store is updated or queried and reply reports the result
||
  others && the student store and the class store are unchanged and reply reports the error
decom: MasterData_Decom
end_process;
process TeacherAccount(op: UserName, req: string) reply: string              /* [F6] 教师账号与权限管理 */
FSF:
  the request maintains a teacher account and op is an admin &&
  teachers is updated and reply reports success
||
  the request asks whether op may use a system feature on a course &&
  reply tells whether access is allowed according to role and taught courses
||
  others && teachers is unchanged and reply reports the error
decom: MasterData_Decom
end_process;
function Authorized(ts: map UserName to Teacher, op: UserName, c: CourseId): bool   /* [C3] */
  op inset dom(ts) and ts(op).role = <Admin> && Authorized = true
||
  op inset dom(ts) and ts(op).role = <Teacher> and c inset ts(op).courses && Authorized = true
||
  others && Authorized = false
end_function
end_module;

/* ---------- bottom level: formal FSF ----------
   Write rule (final grammar): each store is declared in the module whose processes write it;
   sub-modules only read ancestor stores. Master data lives in MasterData_Decom; transactional
   records live in its sub-module Records_Decom. (Awaiting Prof. Liu's confirmation.) */
module MasterData_Decom / SYSTEM_Classroom;
var
  students: map StudentId to Student;         /* [D1]; map key gives 学号唯一 [C4] */
  classes: map ClassId to Class;              /* [D2] */
  courses: map CourseId to Course;            /* [D3]; [C4] */
  timetable: set of TimetableEntry;           /* [D4] */
  teachers: map UserName to Teacher           /* [D8]; [C4] */
;
inv
  forall[t: rng(teachers)] | len(t.password) >= min_pwd_len;  /* [C6] */
  forall[e1, e2: timetable] | e1 = e2 or e1.slot <> e2.slot
        or e1.class_id <> e2.class_id
           and courses(e1.course_id).teacher <> courses(e2.course_id).teacher;  /* [C7] */
  forall[s: rng(students)] | s.class_id inset dom(classes);  /* [C8] */
  forall[c: rng(courses)] | c.teacher inset dom(teachers);  /* [C8] */
  forall[e: timetable] | e.class_id inset dom(classes) and e.course_id inset dom(courses);  /* [C8] */
  forall[c: rng(classes)] | c.head_teacher inset dom(teachers)  /* [C8] */
;
process AddTeacher(op: UserName, u: UserName, t: Teacher) ok: bool          /* [F6][D8] */
ext rd courses wr teachers
FSF:
  op inset dom(~teachers) and ~teachers(op).role = <Admin>                    /* [C3] */
  and u notin dom(~teachers)                                                  /* [C4] */
  and len(t.password) >= min_pwd_len                                          /* [C6] */
  and subset(t.courses, dom(courses))                                         /* [C8] */
  && teachers = override(~teachers, {u -> t}) and ok = true
||
  others && teachers = ~teachers and ok = false
end_process;
process CheckAccess(op: UserName, c: CourseId) allowed: bool                /* [F6][C3] */
ext rd teachers
FSF:
  op inset dom(teachers) and Authorized(teachers, op, c)
  && allowed = true
||
  others && allowed = false
end_process;
process CheckAccess_d2(op: UserName, c: CourseId) allowed: bool                
ext rd teachers
FSF:
  c <= 10 && allowed = true
||
  c > 10 && allowed = false
end_process;
process CheckAccess_d3(op: UserName, c: CourseId) allowed: bool                
ext rd teachers
FSF:
  c < 10 && allowed = true
||
  c >= 10 and c <= 20 && allowed = false
||
  c > 20 && allowed = false
end_process;
process CheckAccess_dg(op: UserName, c: CourseId) allowed: bool                
ext rd teachers
FSF:
  c < 10 && allowed = true
||
  c > 10 && allowed = false
||
  others && allowed = false
end_process;
process CheckAccess_dc(op: UserName, c: CourseId) allowed: bool                
ext rd teachers
FSF:
  c <= 10 && allowed = true
||
  c > 10 && allowed = false
||
  others && allowed = false
end_process;
process AddStudent(op: UserName, sid: StudentId, s: Student) ok: bool       /* [F5][D1] */
ext rd teachers rd classes wr students
FSF:
  op inset dom(teachers) and teachers(op).role = <Admin>                      /* [C3] */
  and sid notin dom(~students)                                                /* [C4] */
  and s.class_id inset dom(classes)                                           /* [C8] */
  && students = override(~students, {sid -> s}) and ok = true
||
  others && students = ~students and ok = false
end_process;
process AddStudent_d2(op: UserName, sid: StudentId, s: Student) ok: bool       
ext rd teachers rd classes wr students
FSF:
  sid <= 10 && students = override(~students, {sid -> s}) and ok = true
||
  sid > 10 && students = ~students and ok = false
end_process;
process AddStudent_d3(op: UserName, sid: StudentId, s: Student) ok: bool       
ext rd teachers rd classes wr students
FSF:
  sid < 10 && students = override(~students, {sid -> s}) and ok = true
||
  sid >= 10 and sid <= 20 && students = ~students and ok = false
||
  sid > 20 && students = ~students and ok = false
end_process;
process AddStudent_dg(op: UserName, sid: StudentId, s: Student) ok: bool       
ext rd teachers rd classes wr students
FSF:
  sid < 10 && students = override(~students, {sid -> s}) and ok = true
||
  sid > 10 && students = ~students and ok = false
||
  others && students = ~students and ok = false
end_process;
process AddStudent_dc(op: UserName, sid: StudentId, s: Student) ok: bool       
ext rd teachers rd classes wr students
FSF:
  sid <= 10 && students = override(~students, {sid -> s}) and ok = true
||
  sid > 10 && students = ~students and ok = false
||
  others && students = ~students and ok = false
end_process;
process UpdateStudent(op: UserName, sid: StudentId, s: Student) ok: bool    /* [F5] 改 */
ext rd teachers rd classes wr students
FSF:
  op inset dom(teachers) and teachers(op).role = <Admin>
  and sid inset dom(~students) and s.class_id inset dom(classes)
  && students = override(~students, {sid -> s}) and ok = true
||
  others && students = ~students and ok = false
end_process;
